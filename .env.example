# ============================================================
# Google Apps Script の公開URL
# （設定手順は README.md を参照）
# ============================================================
GAS_URL=https://script.google.com/macros/s/ここにURLを貼る/exec

# ============================================================
# Slack Bot Token（画像アップロードに必要）
# 取得手順:
#   1. https://api.slack.com/apps → 「Create New App」
#   2. 「OAuth & Permissions」→ Bot Token Scopes に以下を追加:
#      - chat:write
#      - files:write
#   3. 「Install to Workspace」→ Bot User OAuth Token をコピー
# ============================================================
SLACK_BOT_TOKEN=xoxb-ここにトークンを貼る

# ============================================================
# 投稿先チャンネルID（チャンネル名ではなくID）
# 取得方法: Slackでチャンネルを右クリック →「チャンネルIDをコピー」
# 例: C0123456789
# ※ ボットをチャンネルに招待しておくこと（/invite @ボット名）
# ============================================================
SLACK_CHANNEL_ID=C0123456789ここにIDを貼る

# ============================================================
# Surge.sh の公開ドメイン名（英数字とハイフンのみ）
# 例: my-team-progress → https://my-team-progress.surge.sh
# ============================================================
SURGE_DOMAIN=my-team-progress
